DATABASE_URL=postgresql+psycopg://sourcelens:sourcelens@127.0.0.1:55432/sourcelens
REDIS_URL=redis://127.0.0.1:56379/0
WORKSPACE_DIR=.sourcelens/tmp
CLONE_TIMEOUT=120
JOB_TIMEOUT=600
MAX_CLONE_BYTES=536870912
MAX_TEXT_BYTES=104857600
MAX_FILE_BYTES=1048576
MAX_FILES=10000
MAX_ENTRIES=50000
# EMBEDDING_PROVIDER=hashing runs fully offline (default); set to "voyage"
# or "openai" for real code embeddings instead (with the matching API key
# below). OpenAI's text-embedding-3-* models are truncated to the schema's
# fixed dimension via the `dimensions` parameter, so no migration is needed.
EMBEDDING_PROVIDER=hashing
EMBEDDING_BATCH_SIZE=64
# VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_PROVIDER=anthropic (default) or "openai". Required for /chat and
# /chat/stream; without a matching API key those endpoints fail clearly
# (agent_unconfigured) while everything else keeps working.
AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AGENT_MODEL defaults to claude-sonnet-5 for anthropic and gpt-4o-mini for
# openai; set it explicitly to override either default.
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_ITERATIONS=6
AGENT_SEARCH_K=8
# Explicit allow-list (no wildcard) of browser origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173
# Unset (default): the API stays open, for local single-operator use. Set
# this before exposing the service beyond localhost — every /api/* request
# then needs a matching X-API-Key header.
# API_KEY=
ARCHITECTURE_CACHE_TTL_SECONDS=86400

